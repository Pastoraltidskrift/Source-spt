<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preload" as="style" href="{{asset "built/login.css"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "built/login.css"}}">

    <style>
        :root {
            --background-color: {{@custom.site_background_color}};
        }
    </style>

    <script>
        var backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--background-color').trim().slice(1);

        if (backgroundColor.length === 3) {
            backgroundColor = backgroundColor[0] + backgroundColor[0] + backgroundColor[1] + backgroundColor[1] + backgroundColor[2] + backgroundColor[2];
        }

        var red = parseInt(backgroundColor.substr(0, 2), 16);
        var green = parseInt(backgroundColor.substr(2, 2), 16);
        var blue = parseInt(backgroundColor.substr(4, 2), 16);
        var contrast = ((red * 299) + (green * 587) + (blue * 114)) / 1000;

        document.documentElement.className = contrast >= 128 ? 'has-dark-text' : 'has-light-text';
    </script>

    {{ghost_head}}
</head>
<body class="custom-login-template">
    <div class="login-shell">
        <header class="login-header">
            <a class="login-logo is-title" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
        </header>

        {{#post}}
        <main class="login-main">
            {{#if @member}}
                <section class="login-content" aria-labelledby="login-title">
                    <h1 id="login-title" class="login-title is-title">Du är inloggad</h1>
                    <p class="login-intro is-body">Du är inloggad som <strong>{{@member.email}}</strong>.</p>
                    <a class="login-button" href="{{@site.url}}">Fortsätt till webbplatsen</a>
                </section>
            {{else}}
                <section class="login-content" aria-labelledby="login-title">
                    <h1 id="login-title" class="login-title is-title">{{title}}</h1>
                    <p class="login-intro is-body">
                        {{#if custom_excerpt}}
                            {{custom_excerpt}}
                        {{else}}
                            Ange din e-postadress så skickar vi en engångskod.
                        {{/if}}
                    </p>

                    <form class="gh-form login-form" data-members-form="signin" data-members-otc="true">
                        <div class="login-form-fields">
                            <label class="login-label" for="login-email">E-postadress</label>
                            <input class="gh-form-input login-input" id="login-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="E-post" data-members-email required>
                            <button class="gh-button login-button" type="submit">
                                <span class="login-button-default">Logga in</span>
                                <span class="login-button-loading">Skickar…</span>
                            </button>
                        </div>

                        <p class="login-message login-message-success" role="status">
                            Kontrollera din inkorg och använd koden för att logga in.
                        </p>
                        <p class="login-message login-message-error" data-members-error role="alert"></p>
                    </form>
                </section>
            {{/if}}

            <section class="login-content" id="app-login-done" aria-labelledby="app-login-done-title" hidden>
                <h1 id="app-login-done-title" class="login-title is-title">Klart</h1>
                <p class="login-intro is-body">Du är inloggad i appen och kan stänga den här fliken.</p>
                <button class="gh-button login-button" type="button" id="app-login-open">Öppna appen</button>
            </section>
        </main>
        {{/post}}

        <footer class="login-footer">
            <a href="{{@site.url}}">Till {{@site.title}}</a>
        </footer>
    </div>

    <script>
        (function () {
            // Fliken hoppar till appen en gång. Medlemscookien ligger kvar i
            // webbläsaren, så utan spärren skickade en kvarglömd flik läsaren
            // till appen varje gång webbläsaren öppnades eller laddade om den.
            // sessionStorage följer fliken men inte nya flikar, så nästa
            // Logga in i appen hoppar tillbaka som vanligt.
            var RETURNED_KEY = 'spt-app-login-returned';
            var returned = false;
            var timer = null;

            function hasReturned() {
                if (returned) return true;
                try {
                    return sessionStorage.getItem(RETURNED_KEY) === '1';
                } catch (e) {
                    return false;
                }
            }

            function markReturned() {
                returned = true;
                try {
                    sessionStorage.setItem(RETURNED_KEY, '1');
                } catch (e) {}
            }

            function stopPolling() {
                if (timer !== null) {
                    clearInterval(timer);
                    timer = null;
                }
            }

            function showDone() {
                var done = document.getElementById('app-login-done');
                document.querySelectorAll('.login-main > .login-content').forEach(function (section) {
                    section.hidden = section !== done;
                });
            }

            // Ghosts token gäller tio minuter, så den hämtas på nytt vid varje hopp.
            async function fetchToken() {
                try {
                    var res = await fetch('/members/api/session', {credentials: 'include'});
                    if (!res.ok) return null;
                    return (await res.text()).trim() || null;
                } catch (e) {
                    return null;
                }
            }

            async function returnToApp() {
                var token = await fetchToken();
                if (!token || hasReturned()) return;
                stopPolling();
                markReturned();
                showDone();
                window.location.href = 'spt://auth?token=' + encodeURIComponent(token);
            }

            document.getElementById('app-login-open').addEventListener('click', async function () {
                var token = await fetchToken();
                if (token) {
                    window.location.href = 'spt://auth?token=' + encodeURIComponent(token);
                }
            });

            if (hasReturned()) {
                if ({{#if @member}}true{{else}}false{{/if}}) {
                    showDone();
                    return;
                }
                // Utloggad sedan förra hoppet: fliken får logga in på nytt.
                returned = false;
                try {
                    sessionStorage.removeItem(RETURNED_KEY);
                } catch (e) {}
            }

            // Inloggningen kan bli klar i en annan flik, till exempel via
            // länken i mejlet, så sidan frågar tills sessionen finns.
            returnToApp();
            timer = setInterval(returnToApp, 1500);
        })();
    </script>

    {{ghost_foot}}
</body>
</html>
