<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="preload" as="style" href="{{asset "built/login.css"}}">
    <link rel="stylesheet" type="text/css" href="{{asset "built/login.css"}}">

    <style>
        :root {
            --background-color: {{@custom.site_background_color}};
        }
    </style>

    <script>
        var backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--background-color').trim().slice(1);

        if (backgroundColor.length === 3) {
            backgroundColor = backgroundColor[0] + backgroundColor[0] + backgroundColor[1] + backgroundColor[1] + backgroundColor[2] + backgroundColor[2];
        }

        var red = parseInt(backgroundColor.substr(0, 2), 16);
        var green = parseInt(backgroundColor.substr(2, 2), 16);
        var blue = parseInt(backgroundColor.substr(4, 2), 16);
        var contrast = ((red * 299) + (green * 587) + (blue * 114)) / 1000;

        document.documentElement.className = contrast >= 128 ? 'has-dark-text' : 'has-light-text';
    </script>

    {{ghost_head}}
</head>
<body class="custom-login-template">
    <div class="login-shell">
        <header class="login-header">
            <a class="login-logo is-title" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}">
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
        </header>

        {{#post}}
        {{!-- Samma mall används av två sidor: /app-login skickar läsaren till
              appen och /arkiv-login till arkivet på arkiv.pastoraltidskrift.se. --}}
        <main class="login-main" data-login-mode="{{#match slug "arkiv-login"}}arkiv{{else}}app{{/match}}">
            {{#if @member}}
                <section class="login-content" aria-labelledby="login-title">
                    <h1 id="login-title" class="login-title is-title">Du är inloggad</h1>
                    <p class="login-intro is-body">Du är inloggad som <strong>{{@member.email}}</strong>.</p>
                    {{#match slug "arkiv-login"}}
                        <p class="login-intro is-body">Du skickas vidare till arkivet.</p>
                    {{else}}
                        <a class="login-button" href="{{@site.url}}">Fortsätt till webbplatsen</a>
                    {{/match}}
                </section>
            {{else}}
                <section class="login-content" aria-labelledby="login-title">
                    <h1 id="login-title" class="login-title is-title">{{title}}</h1>
                    <p class="login-intro is-body">
                        {{#if custom_excerpt}}
                            {{custom_excerpt}}
                        {{else}}
                            Ange din e-postadress så skickar vi en engångskod.
                        {{/if}}
                    </p>

                    <form class="gh-form login-form" data-members-form="signin" data-members-otc="true">
                        <div class="login-form-fields">
                            <label class="login-label" for="login-email">E-postadress</label>
                            <input class="gh-form-input login-input" id="login-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="E-post" data-members-email required>
                            <button class="gh-button login-button" type="submit">
                                <span class="login-button-default">Logga in</span>
                                <span class="login-button-loading">Skickar…</span>
                            </button>
                        </div>

                        <p class="login-message login-message-success" role="status">
                            Kontrollera din inkorg och använd koden för att logga in.
                        </p>
                        <p class="login-message login-message-error" data-members-error role="alert"></p>
                    </form>
                </section>
            {{/if}}

            <section class="login-content" id="app-login-done" aria-labelledby="app-login-done-title" hidden>
                <h1 id="app-login-done-title" class="login-title is-title">Klart</h1>
                <p class="login-intro is-body">Du är inloggad i appen och kan stänga den här fliken.</p>
                <button class="gh-button login-button" type="button" id="app-login-open">Öppna appen</button>
            </section>

            <section class="login-content" id="arkiv-login-sending" aria-labelledby="arkiv-login-sending-title" hidden>
                <h1 id="arkiv-login-sending-title" class="login-title is-title">Du är inloggad</h1>
                <p class="login-intro is-body">Du skickas vidare till arkivet.</p>
            </section>

            <section class="login-content" id="arkiv-login-done" aria-labelledby="arkiv-login-done-title" hidden>
                <h1 id="arkiv-login-done-title" class="login-title is-title">Klart</h1>
                <p class="login-intro is-body">Du är inloggad i arkivet.</p>
                <a class="login-button" href="https://arkiv.pastoraltidskrift.se/">Till arkivet</a>
            </section>

            <section class="login-content" id="arkiv-login-restart" aria-labelledby="arkiv-login-restart-title" hidden>
                <h1 id="arkiv-login-restart-title" class="login-title is-title">Logga in från arkivet</h1>
                <p class="login-intro is-body">Inloggningen måste startas från arkivet. Har du loggat in via länken i mejlet kan du gå tillbaka till fliken där du började, eller börja om här.</p>
                <a class="login-button" href="https://arkiv.pastoraltidskrift.se/auth/login">Logga in i arkivet</a>
            </section>
        </main>
        {{/post}}

        <footer class="login-footer">
            <a href="{{@site.url}}">Till {{@site.title}}</a>
        </footer>
    </div>

    <script>
        (function () {
            var ARKIV_URL = 'https://arkiv.pastoraltidskrift.se';
            var main = document.querySelector('.login-main');
            var isMember = {{#if @member}}true{{else}}false{{/if}};
            var timer = null;

            function getFlag(key) {
                try {
                    return sessionStorage.getItem(key) === '1';
                } catch (e) {
                    return false;
                }
            }

            function setFlag(key) {
                try {
                    sessionStorage.setItem(key, '1');
                } catch (e) {}
            }

            function clearFlag(key) {
                try {
                    sessionStorage.removeItem(key);
                } catch (e) {}
            }

            function stopPolling() {
                if (timer !== null) {
                    clearInterval(timer);
                    timer = null;
                }
            }

            // Inloggningen kan bli klar i en annan flik, till exempel via
            // länken i mejlet, så sidan frågar tills sessionen finns.
            function pollUntilSignedIn(step) {
                step();
                timer = setInterval(step, 1500);
            }

            function showSection(id) {
                var shown = document.getElementById(id);
                document.querySelectorAll('.login-main > .login-content').forEach(function (section) {
                    section.hidden = section !== shown;
                });
            }

            // Ghosts token gäller tio minuter, så den hämtas på nytt vid varje hopp.
            async function fetchToken() {
                try {
                    var res = await fetch('/members/api/session', {credentials: 'include'});
                    if (!res.ok) return null;
                    return (await res.text()).trim() || null;
                } catch (e) {
                    return null;
                }
            }

            function appLogin() {
                // Fliken hoppar till appen en gång. Medlemscookien ligger kvar i
                // webbläsaren, så utan spärren skickade en kvarglömd flik läsaren
                // till appen varje gång webbläsaren öppnades eller laddade om den.
                // sessionStorage följer fliken men inte nya flikar, så nästa
                // Logga in i appen hoppar tillbaka som vanligt.
                var RETURNED_KEY = 'spt-app-login-returned';
                var returned = false;

                function hasReturned() {
                    return returned || getFlag(RETURNED_KEY);
                }

                async function returnToApp() {
                    var token = await fetchToken();
                    if (!token || hasReturned()) return;
                    stopPolling();
                    returned = true;
                    setFlag(RETURNED_KEY);
                    showSection('app-login-done');
                    window.location.href = 'spt://auth?token=' + encodeURIComponent(token);
                }

                document.getElementById('app-login-open').addEventListener('click', async function () {
                    var token = await fetchToken();
                    if (token) {
                        window.location.href = 'spt://auth?token=' + encodeURIComponent(token);
                    }
                });

                if (hasReturned()) {
                    if (isMember) {
                        showSection('app-login-done');
                        return;
                    }
                    // Utloggad sedan förra hoppet: fliken får logga in på nytt.
                    clearFlag(RETURNED_KEY);
                }

                pollUntilSignedIn(returnToApp);
            }

            function arkivLogin() {
                // Arkivet skickar med state och returnTo. Bryggan skickar tillbaka
                // dem oförändrade, och arkivet kontrollerar state mot sin cookie.
                var params = new URLSearchParams(window.location.search);
                var state = params.get('state');
                var returnTo = params.get('returnTo') || '/';
                if (!state) {
                    showSection('arkiv-login-restart');
                    return;
                }

                // Arkivet godtar varje state en gång. Utan spärren skulle Tillbaka
                // i webbläsaren posta samma state igen och få ett fel från arkivet.
                var postedKey = 'spt-arkiv-login-posted:' + state;
                var posted = false;
                if (getFlag(postedKey)) {
                    showSection('arkiv-login-done');
                    return;
                }

                async function postToArchive() {
                    var token = await fetchToken();
                    if (!token || posted) return;
                    posted = true;
                    stopPolling();
                    setFlag(postedKey);
                    showSection('arkiv-login-sending');

                    // Token skickas i POST-kroppen, aldrig i URL:en.
                    var form = document.createElement('form');
                    form.method = 'post';
                    form.action = ARKIV_URL + '/auth/ghost';
                    [['token', token], ['state', state], ['returnTo', returnTo]].forEach(function (field) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = field[0];
                        input.value = field[1];
                        form.appendChild(input);
                    });
                    document.body.appendChild(form);
                    form.submit();
                }

                pollUntilSignedIn(postToArchive);
            }

            if (main && main.dataset.loginMode === 'arkiv') {
                arkivLogin();
            } else {
                appLogin();
            }
        })();
    </script>

    {{ghost_foot}}
</body>
</html>
